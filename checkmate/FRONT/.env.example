# Environment Configuration Template
# 이 파일을 복사하여 .env.development 또는 .env.production으로 사용하세요
# Git에 커밋되는 템플릿 파일입니다.

# API Base URL
# 개발: http://localhost:8080
# 프로덕션: http://your-server-ip:8080
REACT_APP_API_BASE_URL=http://localhost:8080

# API Timeout (밀리초)
REACT_APP_API_TIMEOUT=10000

# Proxy 설정 (개발 환경에서 CORS 우회용)
REACT_APP_PROXY_PATH=/api2
REACT_APP_PROXY_TARGET=http://localhost:8080
